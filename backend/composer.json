{
  "name": "fracz/supla-scripts",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-xml": "*",
    "beberlei/assert": "^2.7",
    "defuse/php-encryption": "^2.0",
    "firebase/php-jwt": "^4.0",
    "illuminate/database": "^6.20",
    "illuminate/events": "^6.20",
    "illuminate/pagination": "^6.20",
    "jdorn/file-system-cache": "@dev",
    "m6web/statsd": "^1.3",
    "monolog/monolog": "^1.23",
    "mtdowling/cron-expression": "^1.2",
    "nesbot/carbon": "^2.0",
    "ramsey/uuid": "^3.7",
    "robmorgan/phinx": "^0.8",
    "tuupola/slim-basic-auth": "^3.4",
    "tuupola/slim-jwt-auth": "^3.8",
    "slim/slim": "^3.8",
    "supla/api-client": "^2.1",
    "symfony/console": "^3.3",
    "symfony/process": "^3.3",
    "twig/twig": "^2.5",
    "php-pushover/php-pushover": "^1.0",
    "myclabs/php-enum": "^1.7"
  },
  "autoload": {
    "psr-4": {
      "suplascripts\\": "./"
    }
  },
  "scripts": {
    "test": "phpunit",
    "rector": "rector process",
    "rector:check": "rector process --dry-run",
    "test:compatibility": "@php tests/php83-smoke.php",
    "test:php83": "@test:compatibility",
    "phpcs": "phpcs --ignore=*/vendor/*,*/database/migrations/* --standard=../scripts/phpcs-rules.xml .",
    "phpcbf": "phpcbf --ignore=*/vendor/*,*/database/migrations/* --standard=../scripts/phpcs-rules.xml ."
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.1",
    "rector/rector": "^2.7"
  }
}
